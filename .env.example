# 数据库：开发可用 SQLite；生产环境改为 mysql://用户名:密码@127.0.0.1:3306/sketchtoui。
# 不要把真实连接凭据、访问密钥或 SMTP 密码提交到 Git。
DATABASE_DSN=sqlite:///data/workspace/sketch.db

# 应用与会话：生产环境应使用 HTTPS 域名，例如 https://sketchtoui.com。
APP_BASE_URL=http://127.0.0.1:8123
FRONTEND_ORIGINS=http://localhost:8122,http://127.0.0.1:8122
SESSION_DAYS=7
# 缓存：默认进程内内存，无需 Redis；重启会清空 Session、验证码与限流。
# 多 Web Worker / 多实例部署改为 redis，并填写 REDIS_URL。
# 未设置 CACHE_BACKEND 时：有 REDIS_URL 则使用 redis，否则使用 memory。
CACHE_BACKEND=memory
REDIS_URL=

# Sketch 导入安全阈值：限制 ZIP Bomb、异常压缩比和临时磁盘占用。
IMPORT_MAX_UPLOAD_BYTES=524288000
IMPORT_MAX_ARCHIVE_ENTRIES=25000
IMPORT_MAX_ARCHIVE_FILE_BYTES=104857600
IMPORT_MAX_EXTRACTED_BYTES=2147483648
IMPORT_MAX_COMPRESSION_RATIO=150
# 单机默认串行解析，避免大 Sketch 同时占满 CPU 与内存。
IMPORT_MAX_WORKERS=1

# 邮箱验证码：本地默认 console，从后端输出读取验证码；生产环境改为 smtp。
EMAIL_DELIVERY=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 文件存储：默认保存到本地 data/storage，无需 MinIO；也可填写绝对目录。
# Web 和 MCP 必须指向同一个持久目录，勿将其配置为公开静态目录。
# 未设置 STORAGE_BACKEND 时：有 MINIO_ENDPOINT 则使用 minio，否则使用 local。
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/storage
# 可选 MinIO：将 STORAGE_BACKEND 改为 minio，并填写以下配置。
# MINIO_ENDPOINT 只填写 host:port；HTTPS MinIO 设置 MINIO_SECURE=true。
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sketchtoui
MINIO_SECURE=false

# Remote MCP：生产环境仅监听本机，由 HTTPS 反向代理对外暴露。
MCP_HOST=127.0.0.1
MCP_PORT=8124
MCP_PUBLIC_URL=http://127.0.0.1:8124/mcp
MCP_ISSUER_URL=http://127.0.0.1:8123
# MCP 限流：0 表示关闭对应限制。
MCP_RATE_LIMIT_PER_MINUTE=600
MCP_GLOBAL_RATE_LIMIT_PER_MINUTE=6000

# 画板 PNG 预览最长边；按服务器字体实际路径填写可改善中文文本预览。
MCP_PREVIEW_MAX_DIMENSION=1600
MCP_PREVIEW_FONT_PATH=
